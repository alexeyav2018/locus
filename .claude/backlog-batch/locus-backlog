#!/usr/bin/env bash
# Батч бэклога locus: до MAX_RUNS сессий подряд за запуск, пока в очереди
# есть что брать; замок — имя tmux-сессии.
set -uo pipefail

REPO=/home/vorotovalexey/projects/locus
SESSION=locus-backlog
TIMER=locus-backlog.timer
PROMPT="$REPO/.claude/backlog-batch/task-prompt.md"
POLICY="$REPO/.claude/backlog-batch/question-policy.md"
KEY="$HOME/.ssh/locus_backlog"
SELF="$(readlink -f "$0")"
MAX_RUNS=10
POLL=30

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

usage() {
    cat <<'USAGE'
locus-backlog — периодический прогон бэклога locus

  start    включить периодические запуски (переживает перезагрузку)
  stop     выключить их; текущая сессия доигрывает, новых цикл не поднимает
  status   расписание, текущая задача, очередь, активное изменение, история
  attach   подключиться к живой сессии в терминале
  kill     прервать текущую сессию и весь цикл (незакоммиченное останется)
  next     что взяла бы следующая сессия

Внутренние: run (вызывается таймером), _session (вызывается внутри tmux).
USAGE
}

# Есть ли в очереди что брать: активное изменение либо строка таблицы порядка
# с пустым «Статусом», у которой все зависимости выполнены. Правило то же, что
# у сессии (task-prompt.md, «Шаг 0»). Зависимость, которой нет в таблице, —
# работа, сделанная до бэклога: выполнена, если её изменение в архиве.
# Печатает, что взяла бы сессия; код возврата 1 — брать нечего.
next_item() {
    python3 -I - "$REPO" <<'PY'
import pathlib, re, sys
repo = pathlib.Path(sys.argv[1])
changes = repo / "openspec/changes"
active = sorted(p.name for p in changes.iterdir() if p.is_dir() and p.name != "archive")
if active:
    print("активное изменение " + ", ".join(active)); sys.exit(0)
text = (repo / "openspec/backlog.md").read_text()
table = text.split("## 3. Таблица порядка", 1)[1].split("\n## ", 1)[0]
rows = []
for line in table.splitlines():
    cells = [c.strip() for c in line.strip().strip("|").split("|")]
    if len(cells) < 8 or not cells[0].startswith("`"):
        continue
    rows.append((cells[0].strip("`"), re.findall(r"`([^`]+)`", cells[2]), cells[7]))
status = {i: st for i, _, st in rows}
archived = {re.sub(r"^\d{4}-\d{2}-\d{2}-", "", p.name) for p in (changes / "archive").iterdir()}
def done(dep):
    return status[dep] == "✅" if dep in status else dep in archived
for item, deps, st in rows:
    if st == "" and all(done(d) for d in deps):
        print("строка " + item); sys.exit(0)
sys.exit(1)
PY
}

# Снимок всех локальных веток: не сдвинулась ни одна — сессия ничего
# не закоммитила.
refs_snapshot() {
    git -C "$REPO" for-each-ref --format='%(objectname) %(refname)' refs/heads
}

case "${1:-status}" in

start)
    systemctl --user enable --now "$TIMER" || exit 1
    systemctl --user list-timers "$TIMER" --no-pager
    ;;

stop)
    systemctl --user disable --now "$TIMER"
    echo "Расписание остановлено. Текущая задача, если идёт, доигрывает до конца."
    ;;

attach)
    exec tmux attach -t "$SESSION"
    ;;

kill)
    # Сначала цикл, потом сессию: иначе цикл увидит её конец и поднимет новую.
    # KillMode=process — останавливается только сам цикл, tmux гасим отдельно.
    systemctl --user stop locus-backlog.service
    if tmux kill-session -t "=$SESSION" 2>/dev/null; then
        echo "Сессия и цикл прерваны. Проверьте git status в $REPO."
    else
        echo "Живой сессии нет; цикл, если шёл, остановлен."
    fi
    ;;

next)
    next_item || echo "брать нечего"
    ;;

status)
    echo "== расписание =="
    if systemctl --user is-active --quiet "$TIMER"; then
        systemctl --user list-timers "$TIMER" --no-pager | sed -n '1,2p'
    else
        echo "остановлено (locus-backlog start — включить)"
    fi

    echo
    echo "== текущая задача =="
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "идёт; смотреть — locus-backlog attach"
    else
        echo "не идёт"
    fi
    systemctl --user is-active --quiet locus-backlog.service \
        && echo "цикл запусков идёт; ход — journalctl --user -u locus-backlog.service"

    echo
    echo "== очередь =="
    next_item || echo "брать нечего"

    echo
    echo "== активное изменение =="
    ( cd "$REPO" && npx -y @fission-ai/openspec@latest list 2>/dev/null ) || echo "не определено"

    echo
    echo "== репозиторий =="
    ( cd "$REPO" \
      && echo "ветка:  $(git branch --show-current)" \
      && echo "правки: $(git status --short | wc -l) файлов не закоммичено" \
      && git log --oneline -3 )
    ;;

run)
    # Цикл: сессия отработала — смотрим очередь; есть что брать — поднимаем
    # следующую сразу, не дожидаясь таймера. Не больше MAX_RUNS за запуск.
    for ((n = 1; n <= MAX_RUNS; n++)); do
        if ! next_item >/dev/null; then
            echo "брать нечего — цикл окончен"
            break
        fi
        # Замок: tmux откажется создать сессию с занятым именем — это и есть проверка.
        if ! tmux new-session -d -s "$SESSION" -c "$REPO" "$SELF _session" 2>/dev/null; then
            echo "сессия $SESSION уже идёт — запуск пропущен"
            break
        fi
        before="$(refs_snapshot)"
        echo "сессия $n из $MAX_RUNS запущена: $(next_item)"
        while tmux has-session -t "=$SESSION" 2>/dev/null; do
            sleep "$POLL"
        done
        echo "сессия $n из $MAX_RUNS завершилась"

        if [ "$(refs_snapshot)" = "$before" ]; then
            echo "сессия ничего не закоммитила — цикл остановлен, чтобы не жечь квоту впустую"
            break
        fi
        if ! systemctl --user is-active --quiet "$TIMER"; then
            echo "расписание остановлено — новых сессий цикл не поднимает"
            break
        fi
    done
    ;;

_session)
    cd "$REPO" || exit 1
    unset CLAUDE_CODE_CHILD_SESSION
    export CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1
    export GIT_SSH_COMMAND="ssh -i $KEY -o IdentitiesOnly=yes"
    exec claude --dangerously-skip-permissions \
                --remote-control "$SESSION" \
                --append-system-prompt-file "$POLICY" \
                "$(cat "$PROMPT")"
    ;;

*)
    usage
    exit 1
    ;;
# «exit» на одной строке с «esac» обязателен. Цикл живёт часами, а сессии
# тем временем переключают ветки, и этот файл меняется под ногами. Bash
# читает скрипт по мере исполнения, но команду до конца строки разбирает
# целиком: так он, закончив case, выходит, а не дочитывает с прежнего
# смещения кусок новой версии файла.
esac; exit $?
