<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>ru.locus</groupId>
    <artifactId>locus</artifactId>
    <version>3.12.0</version>
    <name>locus</name>
    <description>Платформа поддержки учителя математики</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Версией AWS SDK Spring Boot не управляет: в его спецификации этой
            библиотеки нет. Поэтому здесь спецификация самого SDK — она
            согласует версии его частей между собой.
        -->
        <awssdk.version>2.54.13</awssdk.version>
        <thumbnailator.version>0.4.21</thumbnailator.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <!--
            Отрисовка текста Задачи (ADR-0058). openhtmltopdf ставится не моложе
            двух недель; свой PDFBox он тянет транзитивно, но прямая
            зависимость pdfbox выше главнее — копия PDFBox в приложении одна.
        -->
        <openhtmltopdf.version>1.1.97</openhtmltopdf.version>
        <commonmark.version>0.30.0</commonmark.version>
        <jlatexmath.version>1.0.7</jlatexmath.version>
        <!--
            Java SDK MCP Spring Boot тоже не управляет: его спецификация
            согласует части SDK между собой.
        -->
        <mcp.version>2.1.0</mcp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                openhtmltopdf тянет xmpbox своей версии PDFBox; семейство
                PDFBox держится одной версией — той, что у pdfbox.
            -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>xmpbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Файлы: объектное хранилище (ADR-0021). SDK виден только пакету
            ru.locus.file; выше него о S3 не знает никто.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!--
            Пережатие снимков. Взят ради разворота по сведениям о съёмке (EXIF):
            чистый ImageIO этого не делает, и забытый разворот — тихая ошибка,
            при которой файл цел, объём уменьшился, а фотография лежит на боку.
        -->
        <dependency>
            <groupId>net.coobird</groupId>
            <artifactId>thumbnailator</artifactId>
            <version>${thumbnailator.version}</version>
        </dependency>

        <!--
            Сборка PDF Задачи из картинок и страниц сборника (ADR-0044).
            Только перенос страниц и укладка картинок: содержимое PDF
            система не интерпретирует.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!--
            Отрисовка Текста Задачи в PDF внутри приложения (ADR-0058):
            CommonMark переводит Markdown в разметку, openhtmltopdf вёрстает
            страницу поверх того же PDFBox, JLaTeXMath рисует формулы
            векторно. Ничего не загружают по адресам из текста — это держит
            ProblemTextRendering.
        -->
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.scilab.forge</groupId>
            <artifactId>jlatexmath</artifactId>
            <version>${jlatexmath.version}</version>
        </dependency>
        <dependency>
            <groupId>org.scilab.forge</groupId>
            <artifactId>jlatexmath-font-cyrillic</artifactId>
            <version>${jlatexmath.version}</version>
        </dependency>

        <!--
            Сервер MCP внутри приложения (ADR-0054): через него Помощник
            действует в Локусе под личностью учителя (ADR-0056). SDK виден
            только пакету ru.locus.assistant; области объявляют инструменты
            через его абстракцию и типов SDK не знают — как о S3 не знает
            никто выше ru.locus.file.
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>

        <!-- Разработка: приложение само поднимает базу из compose.yaml -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Тесты: чистый контейнер PostgreSQL на каждый прогон -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Тесты: MinIO как S3-совместимое хранилище. Объектная реализация —
            единственная, которая пойдёт в бой, и проверяться она обязана
            по-настоящему, а не через файловую подмену.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-minio</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
                Рабочее место Помощника — classpath:agent/** (design.md agent-runner, Р7):
                Локус разворачивает его учителю перед каждой Репликой. Лежит в корне
                репозитория, а не в ресурсах: это документы Помощника, а не настройки
                приложения (ADR-0057). Точечные файлы .mcp.json и .claude/ входят.
            -->
            <resource>
                <directory>agent</directory>
                <targetPath>agent</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- Версия из pom.xml — в бин BuildProperties: её показывает подвал страниц (ADR-0043) -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Короткий хеш коммита — в git.properties и бин GitProperties. Вне git-каталога
                (исходники архивом) сборка не падает: подвал покажет одну версию.
            -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <abbrevLength>7</abbrevLength>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
